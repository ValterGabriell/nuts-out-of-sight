; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="coffyjam"
run/main_scene="uid://ev5ftsrddqx7"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GlobalItensQueOJogadorCarrega="*res://codigos/global/global_itens_que_o_jogador_carrega.gd"
GlobalGerenciadorDeSalvamento="*res://codigos/global/global_gerenciador_de_salvamento.gd"
GlobalGerenciadorDeSinais="*res://codigos/global/global_gerenciador_de_sinais.gd"
GlobalEstoque="*res://codigos/global/global_estoque.gd"
GlobalTransicaoDeCena="*res://codigos/global/global_transicao_de_cena.gd"
GlobalGerenciadorDeBarulho="*res://codigos/global/global_gerenciador_de_barulho.gd"
